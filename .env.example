# ==============================================================================
# APEX Sports Intelligence Platform — Production Environment Configuration
# ==============================================================================
# APEX is designed with a resilient "Zero-Key Local Fallback Engine".
# The system runs 100% locally out-of-the-box without requiring third-party credentials.
# Fill in optional production keys below to connect external upstream providers.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APEX_ENV=production

# Feature Flags
NEXT_PUBLIC_ENABLE_LOCAL_FALLBACK=true
NEXT_PUBLIC_POLL_INTERVAL_SECONDS=15
