# ==============================================================================
# APEX Backend — Production Environment Configuration
# ==============================================================================

# Server Network Host & Port
HOST=0.0.0.0
PORT=8000

# Security & Cryptographic Secrets
# Generate a secure 64-char hex key for production: python -c "import secrets; print(secrets.token_hex(32))"
APEX_JWT_SECRET=apex-sports-ai-cryptographic-token-key-2026-production
JWT_EXPIRATION_HOURS=48

# Database Path (Default: data/cricket.db)
DATABASE_PATH=data/cricket.db

# Optional AI LLM Integration (Google Gemini REST)
# When omitted, APEX automatically runs in Deterministic Local Heuristic Intelligence Mode
GEMINI_API_KEY=

# Optional Upstream Live Sports Provider Keys (When omitted, APEX Calibrated Live Relay is used)
SPORTS_RADAR_API_KEY=
CRICAPI_KEY=
FOOTBALL_DATA_ORG_KEY=

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
